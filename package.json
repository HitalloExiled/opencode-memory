{
  "name": "@hitalloexiled/opencode-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local memory plugin for OpenCode: compaction summaries, context injection, hybrid search (FTS5 + local CPU embeddings) over past sessions, and a SolidJS side-panel GUI (./gui-experimental).",
  "exports": {
    ".": {
      "import": "./index.ts"
    },
    "./gui-experimental": {
      "import": "./dist/gui-experimental.cjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:gui": "tsc --noEmit -p tsconfig.gui.json",
    "gui:build": "vite build",
    "gui:watch": "vite --watch",
    "test": "bun test test"
  },
  "dependencies": {
    "@hitalloexiled/opencode-shared": "github:HitalloExiled/opencode-shared#86b246394d17ebe82c9ca2648dedc03547cf388a",
    "@huggingface/transformers": "^4.3.1",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.17.7",
    "@opencode/client": "2.2.0",
    "@opencode/plugin": "2.2.0",
    "@opencode/schema": "2.2.0",
    "@types/bun": "1.3.3",
    "@types/node": "24.12.2",
    "effect": "4.0.1",
    "solid-js": "1.9.18",
    "typescript": "5.8.2",
    "vite": "5.4.17",
    "vite-plugin-solid": "2.11.15"
  }
}
